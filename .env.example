# Copy to .env (gitignored). Everything is optional.

# Leave MONO_TOKEN empty to run on synthetic data (default). Set it to use your real account.
MONO_TOKEN=
SYNTHETIC_SEED=42

# Model per graph node, "provider:model" (default: local Qwen via Ollama).
# ROUTER_MODEL=ollama:qwen3.6:35b-a3b-q4_K_M
# AGENT_MODEL=anthropic:claude-sonnet-5-5
# COMPOSER_MODEL=openrouter:nvidia/nemotron-3-ultra-550b-a55b:free

# Backup model for every node when the primary one fails (timeout, rate limit, provider down).
# FALLBACK_MODEL=openrouter:nvidia/nemotron-3-ultra-550b-a55b:free

# API keys, only for the providers you use.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Tracing with self-hosted Langfuse (docker compose --profile tracing up -d).
# These two must match the project keys Langfuse creates on first start (docker-compose.yml);
# the values below are the local defaults. UI: http://localhost:3000, admin@mono-agent.test.
# LANGFUSE_PUBLIC_KEY=pk-lf-local
# LANGFUSE_SECRET_KEY=sk-lf-local
# LANGFUSE_ADMIN_PASSWORD=local-only-password
# LANGFUSE_PORT=3000  # change if another app already uses port 3000
